# Dependencies - Vercel will install fresh
node_modules

# Build outputs - Vercel will build
.next
dist
out
.turbo
.nx
tmp

# ESLint packages - NOT needed for docs build
/packages

# Playground - NOT needed for docs
/playground

# Scripts and tools - NOT needed for docs.
#
# Leading slash is load-bearing. Unanchored, `scripts` matches EVERY directory
# of that name at any depth — including apps/docs/scripts, whose
# sync-plugin-stats.ts is the first thing `docs#build` runs. Deploys only
# survived because docs#build kept hitting the turbo cache and never executed
# the command; the first real docs rebuild after that failed with
# ERR_MODULE_NOT_FOUND on a file that is committed and not gitignored.
/scripts
/tools
/distribution

# Testing
coverage
.vitest
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# Development
.vscode
.idea
.cursor
.cursorrules
.agent
.gemini
*.log
.DS_Store
.verdaccio
.husky

# Git
.git
.github

# Large files
graph.json
*.md
!README.md
