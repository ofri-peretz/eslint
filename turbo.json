{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "tsconfig.base.json",
    ".oxlintrc.json",
    ".markdownlint.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.lib.json",
        "package.json",
        "README.md",
        "LICENSE",
        ".npmignore"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "docs#test": {
      "dependsOn": ["^build"]
    },
    "docs#test:coverage": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-conventions#test": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-conventions#test:coverage": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-modernization#test": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-modernization#test:coverage": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-modularity#test": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-modularity#test:coverage": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-operability#test": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-operability#test:coverage": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-reliability#test": {
      "dependsOn": ["^build"]
    },
    "eslint-plugin-reliability#test:coverage": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**", "test-report.junit.xml", "test-results/**"]
    },
    "test:coverage": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", ".oxlintrc.json", ".eslintrc.*", "eslint.config.*", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.lib.json", "package.json"],
      "outputs": [".tsbuildinfo"]
    },
    "//#oxlint": {
      "inputs": [".oxlintrc.json", "packages/**/src/**"],
      "outputs": []
    },
    "//#lint:md": {
      "inputs": [".markdownlint.json", "**/*.md", "!node_modules/**", "!**/dist/**"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
