{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://eslint.interlace.tools/schemas/interlace-numbers.json",
    "title": "InterlaceNumbersManifest",
    "description": "Single source of truth for every plugin/rule count claim across Interlace surfaces (eslint docs, interlace.tools landing, ofriperetz.dev). Generated by apps/docs/scripts/sync-plugin-stats.ts from the package registry. Published plugins only.",
    "type": "object",
    "required": ["schemaVersion", "source", "plugins", "rules", "generatedAt"],
    "properties": {
        "schemaVersion": {
            "type": "integer",
            "const": 1
        },
        "source": {
            "type": "string",
            "description": "Where this file is generated — consumers fetch it from the eslint repo, never edit it"
        },
        "plugins": {
            "type": "object",
            "required": ["total", "security", "quality", "react"],
            "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "security": { "type": "integer", "minimum": 0 },
                "quality": { "type": "integer", "minimum": 0 },
                "react": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },
        "rules": {
            "type": "object",
            "required": ["total", "security", "quality", "react"],
            "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "security": { "type": "integer", "minimum": 0 },
                "quality": { "type": "integer", "minimum": 0 },
                "react": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },
        "generatedAt": {
            "type": "string",
            "format": "date-time"
        }
    },
    "additionalProperties": false
}
