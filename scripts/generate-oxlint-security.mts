#!/usr/bin/env -S npx tsx
/**
 * generate-oxlint-security.mts — the derived files of oxlint-plugin-security
 * (docs/intents/oxlint-plugin-security-drop-in).
 *
 * `index.js` reads `mapping.json` at load time, so it cannot drift from the data.
 * What a human reads is generated here from the same data:
 *
 *   - `package.json`: dependencies pinned to the CURRENT versions of the mapped
 *     plugins (a release of either moves the façade with it);
 *   - `index.d.ts`: the rule-ID union;
 *   - `README.md`: install, the clash warning, the mapping table, the declared
 *     divergences and retired IDs, and the parity line from the gate's last
 *     recorded run (benchmarks/suites/ilb-competitor-parity/drop-in.result.json).
 *
 * Usage:
 *   tsx scripts/generate-oxlint-security.mts          # write
 *   tsx scripts/generate-oxlint-security.mts --check  # exit 1 on drift
 */
import fs from 'node:fs';
import path from 'node:path';
import prettier from 'prettier';

const ROOT = path.resolve(import.meta.dirname, '..');
const PKG = path.join(ROOT, 'packages', 'oxlint-plugin-security');
const SUITE = path.join(ROOT, 'benchmarks', 'suites', 'ilb-competitor-parity');
const CHECK = process.argv.includes('--check');
const FENCE = '```';

type Wrapped = { plugin: string; rule: string; defaultOptions?: unknown[] };
type Retired = { retired: true; reason: string };
const read = (p: string) => JSON.parse(fs.readFileSync(p, 'utf8'));
const mapping = read(path.join(PKG, 'mapping.json')) as {
  incumbent: { name: string; version: string };
  rules: Record<string, Wrapped | Retired>;
};
const divergences = read(path.join(SUITE, 'divergences.json'))
  .classes as Record<
  string,
  { valid: number[]; reason: string; reconsiderIf: string }
>;
const resultPath = path.join(SUITE, 'drop-in.result.json');
const result = fs.existsSync(resultPath) ? read(resultPath) : null;
const pluginVersion = (short: string) =>
  read(path.join(ROOT, 'packages', `eslint-plugin-${short}`, 'package.json'))
    .version as string;
const secureCoding = read(
  path.join(ROOT, 'packages', 'eslint-plugin-secure-coding', 'package.json'),
);

const ids = Object.keys(mapping.rules);

const manifest = {
  name: 'oxlint-plugin-security',
  version: '0.1.0',
  description:
    "Drop-in replacement for eslint-plugin-security on oxlint and Vite+: the same security/<rule> IDs, backed by Interlace's security rules.",
  // Stays private until its ship gate holds — every incumbent rule mapped and
  // drop-in.mjs green (R9). Flipping this publishes the name; Ofri flips it.
  private: true,
  type: 'commonjs',
  main: './index.js',
  types: './index.d.ts',
  files: ['index.js', 'index.d.ts', 'mapping.json', 'README.md', 'LICENSE'],
  keywords: [
    'oxlint',
    'oxlint-plugin',
    'vite-plus',
    'eslint-plugin-security',
    'security',
    'sast',
  ],
  homepage:
    'https://github.com/ofri-peretz/eslint/tree/main/packages/oxlint-plugin-security#readme',
  repository: {
    ...secureCoding.repository,
    directory: 'packages/oxlint-plugin-security',
  },
  bugs: secureCoding.bugs,
  author: secureCoding.author,
  license: 'MIT',
  // The incumbent's own range: a swap must never narrow it.
  engines: { node: '^18.18.0 || ^20.9.0 || >=21.1.0' },
  publishConfig: { access: 'public' },
  scripts: { build: 'tsx ../../scripts/build-package.ts' },
  dependencies: {
    'eslint-plugin-node-security': pluginVersion('node-security'),
    'eslint-plugin-secure-coding': pluginVersion('secure-coding'),
  },
  devDependencies: { [mapping.incumbent.name]: mapping.incumbent.version },
  peerDependencies: { eslint: '^8.40.0 || ^9.0.0 || ^10.0.0' },
  peerDependenciesMeta: { eslint: { optional: true } },
};

const types = `// Generated by scripts/generate-oxlint-security.mts. Do not edit by hand.
import type { TSESLint } from '@typescript-eslint/utils';

export type SecurityRuleId =
${ids.map((id) => `  | '${id}'`).join('\n')};

declare const plugin: {
  meta: { name: 'oxlint-plugin-security'; version: string };
  rules: Record<SecurityRuleId, TSESLint.RuleModule<string, readonly unknown[]>>;
  configs: {
    recommended: TSESLint.FlatConfig.Config;
    'recommended-legacy': { plugins: ['security']; rules: Record<\`security/\${SecurityRuleId}\`, 'warn'> };
  };
};
export = plugin;
`;

const wrapped = ids.filter((id) => !('retired' in mapping.rules[id]));
const retired = ids.filter((id) => 'retired' in mapping.rules[id]);
const row = (id: string) => {
  const e = mapping.rules[id] as Wrapped;
  const pinned = e.defaultOptions
    ? `\`${JSON.stringify(e.defaultOptions[0])}\``
    : '';
  return `| \`security/${id}\` | [\`${e.plugin}/${e.rule}\`](https://www.npmjs.com/package/eslint-plugin-${e.plugin}) | ${pinned} |`;
};
const parity = result
  ? `Measured ${result.measuredOn} against ${result.incumbent}'s own ${result.cases} test cases: **${result.liveInvalid.detected}/${result.liveInvalid.total}** live invalid cases detected, ${result.validFindings.total}/${result.validFindings.of} valid cases reported (${result.validFindings.declared} declared below), ESLint and oxlint ${result.enginesAgree ? 'agree on every case' : 'DISAGREE on some cases'}. Gate: **${result.gate}**.`
  : 'Not yet measured. Run `node benchmarks/suites/ilb-competitor-parity/drop-in.mjs --write`.';

const readme = `# oxlint-plugin-security

> An independent package, not affiliated with eslint-community, eslint-plugin-security or oxc.

A drop-in replacement for [\`eslint-plugin-security\`](https://www.npmjs.com/package/eslint-plugin-security)@${mapping.incumbent.version} on [oxlint](https://oxc.rs/docs/guide/usage/linter/js-plugins) and [Vite+](https://viteplus.dev/guide/lint). It answers to the same \`security/<rule>\` IDs, so your existing rule configuration keeps working, and each ID is backed by an [Interlace](https://eslint.interlace.tools) security rule.

## Install

${FENCE}bash
npm install oxlint-plugin-security --save-dev
${FENCE}

Swap the plugin name and keep everything else:

${FENCE}json
{
  "jsPlugins": ["oxlint-plugin-security"],
  "rules": {
    "security/detect-object-injection": "warn",
    "security/detect-non-literal-fs-filename": "warn"
  }
}
${FENCE}

In Vite+, the same goes in \`vite.config.ts\` under \`lint.jsPlugins\` and \`lint.rules\`. On ESLint, \`security.configs.recommended\` mirrors the incumbent's preset (all ${ids.length} rules at \`warn\`). The pinned options below need ESLint 9.15 or later, because they travel as \`meta.defaultOptions\`.

## Don't load both plugins

Both packages call themselves \`security\`, and oxlint silently keeps only one of them. To run the two side by side while you compare, give the incumbent another name:

${FENCE}json
{
  "jsPlugins": [
    "oxlint-plugin-security",
    { "name": "security-legacy", "specifier": "eslint-plugin-security" }
  ]
}
${FENCE}

## Rule mapping

| Incumbent ID | Backed by | Pinned options |
| :--- | :--- | :--- |
${wrapped.map(row).join('\n')}

## Stricter than the incumbent

These are cases the incumbent's own tests call safe, which we report on purpose:

${
  Object.entries(divergences)
    .map(
      ([cls, d]) =>
        `- **\`security/${cls}\`** (${d.valid.length} case${d.valid.length === 1 ? '' : 's'}): ${d.reason}`,
    )
    .join('\n') || '- None.'
}

## Retired IDs

These IDs still load, as deprecated no-ops, so an existing config never breaks:

${retired.map((id) => `- **\`security/${id}\`**: ${(mapping.rules[id] as Retired).reason}`).join('\n')}

## Parity

${parity}

## License

MIT © [Ofri Peretz](https://github.com/ofri-peretz). Test cases used for parity measurement come from eslint-plugin-security (Apache-2.0).
`;

const planned = new Map<string, string>([
  [path.join(PKG, 'package.json'), JSON.stringify(manifest, null, 2) + '\n'],
  [path.join(PKG, 'index.d.ts'), types],
  [path.join(PKG, 'README.md'), readme],
]);
const drift: string[] = [];
for (const [file, raw] of planned) {
  const content = await prettier.format(raw, {
    ...(await prettier.resolveConfig(file)),
    filepath: file,
  });
  const current = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : null;
  if (current === content) continue;
  drift.push(path.relative(ROOT, file));
  if (!CHECK) fs.writeFileSync(file, content);
}
if (drift.length === 0)
  console.log('✅ oxlint-plugin-security derived files in sync.');
else if (CHECK) {
  console.log(
    `❌ drift: ${drift.join(', ')}\nRun \`npx tsx scripts/generate-oxlint-security.mts\`.`,
  );
  process.exit(1);
} else console.log(`📝 wrote ${drift.join(', ')}`);
