#!/usr/bin/env -S npx tsx
/**
 * survey-oxlint-runtimes.mts — run every plugin's own rule tests on oxlint and
 * record, per rule, whether they pass there.
 *
 * Each package's suite runs with DUAL_ENGINE_SURVEY set, which makes
 * vitest.dual-rule-tester.ts run oxlint's RuleTester for EVERY rule (not only
 * those already claiming oxlint) and log failures instead of throwing. The
 * result, `.agent/oxlint-runtime-survey.json`, is the evidence behind each
 * rule's `meta.interop.runtimes`: a rule claims oxlint only if every one of its
 * cases passed there. `docs/oxlint-runtimes.md` is generated from it.
 *
 * Usage: tsx scripts/survey-oxlint-runtimes.mts [package-dir...]
 */
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawn } from 'node:child_process';
import prettier from 'prettier';

const ROOT = path.resolve(import.meta.dirname, '..');
const OUT = path.join(ROOT, '.agent', 'oxlint-runtime-survey.json');
const requested = process.argv.slice(2);
const packages = (
  requested.length
    ? requested.map((p) => path.basename(p))
    : fs
        .readdirSync(path.join(ROOT, 'packages'))
        .filter((d) => d.startsWith('eslint-plugin-'))
).sort();

const log = path.join(
  fs.mkdtempSync(path.join(os.tmpdir(), 'oxlint-survey-')),
  'survey.jsonl',
);
fs.writeFileSync(log, '');

function runSuite(pkg: string): Promise<void> {
  return new Promise((resolve) => {
    const child = spawn(
      'npx',
      ['vitest', 'run', '--coverage.enabled=false', '--reporter=dot'],
      {
        cwd: path.join(ROOT, 'packages', pkg),
        env: { ...process.env, DUAL_ENGINE_SURVEY: log },
        stdio: 'ignore',
      },
    );
    child.on('close', () => {
      console.log(`  surveyed ${pkg}`);
      resolve();
    });
  });
}

// ponytail: fixed pool of 3 — the machine's endpoint scanner saturates beyond that.
const queue = [...packages];
await Promise.all(
  Array.from({ length: 3 }, async () => {
    for (let pkg = queue.shift(); pkg; pkg = queue.shift()) await runSuite(pkg);
  }),
);

interface Entry {
  package: string;
  rules: string[];
  testName: string;
  cases: number;
  failures: string[];
}
const previous = fs.existsSync(OUT)
  ? (
      JSON.parse(fs.readFileSync(OUT, 'utf8')) as {
        rules: Record<string, unknown>;
      }
    ).rules
  : {};
const rules: Record<
  string,
  { cases: number; failed: number; examples: string[] }
> = {};
for (const line of fs.readFileSync(log, 'utf8').split('\n').filter(Boolean)) {
  const entry = JSON.parse(line) as Entry;
  // No IDs: a test-only wrapper rule, not a published one.
  for (const id of entry.rules) {
    const key = `${entry.package}/${id}`;
    const slot = (rules[key] ??= { cases: 0, failed: 0, examples: [] });
    slot.cases += entry.cases;
    slot.failed += entry.failures.length;
    for (const f of entry.failures)
      if (slot.examples.length < 3) slot.examples.push(f.slice(0, 240));
  }
}

const merged = requested.length
  ? {
      ...Object.fromEntries(
        Object.entries(previous).filter(
          ([k]) => !packages.includes(k.split('/')[0]),
        ),
      ),
      ...rules,
    }
  : rules;
const sorted = Object.fromEntries(
  Object.entries(merged).sort(([a], [b]) => a.localeCompare(b)),
);
// Through prettier, as lint-staged would, so the file does not drift.
fs.writeFileSync(
  OUT,
  await prettier.format(
    JSON.stringify(
      {
        command: 'npm run oxlint:runtimes:survey',
        $comment:
          "Generated by scripts/survey-oxlint-runtimes.mts: each rule's own test cases, run on oxlint's RuleTester. Evidence for meta.interop.runtimes.",
        oxlint: JSON.parse(
          fs.readFileSync(
            path.join(ROOT, 'node_modules/oxlint/package.json'),
            'utf8',
          ),
        ).version,
        rules: sorted,
      },
      null,
      2,
    ) + '\n',
    { ...(await prettier.resolveConfig(OUT)), filepath: OUT },
  ),
);
const all = Object.values(sorted) as { failed: number }[];
console.log(
  `\n${all.length} rules surveyed; ${all.filter((r) => r.failed === 0).length} pass on oxlint.`,
);
