#!/usr/bin/env -S npx tsx
/**
 * generate-oxlint-runtimes-report.mts — docs/oxlint-runtimes.md: every rule
 * that does NOT run on oxlint, and why.
 *
 * Built only from the evidence — `.agent/oxlint-runtime-survey.json` (each
 * rule's own suite on oxlint's RuleTester) and `.agent/type-awareness-scan.tsv`
 * — the same two inputs `meta.interop.runtimes` is derived from, which
 * scripts/__tests__/interop-runtimes.lock.test.ts holds every rule to.
 *
 * Usage:
 *   tsx scripts/generate-oxlint-runtimes-report.mts          # write
 *   tsx scripts/generate-oxlint-runtimes-report.mts --check  # exit 1 on drift
 */
import fs from 'node:fs';
import path from 'node:path';
import prettier from 'prettier';
import {
  allRuleKeys,
  runtimesFor,
  loadEvidence,
} from './lib/oxlint-runtimes.mts';

const ROOT = path.resolve(import.meta.dirname, '..');
const OUT = path.join(ROOT, 'docs', 'oxlint-runtimes.md');
const evidence = loadEvidence(ROOT);

const keys = await allRuleKeys(ROOT);
const eslintOnly = keys
  .map((key) => ({ key, ...runtimesFor(evidence, key) }))
  .filter((r) => r.runtimes.length === 1);
const total = keys.length;

const rows = eslintOnly.map(({ key, reason }) => {
  const [pkg, rule] = key.split('/');
  return `| \`${pkg.replace('eslint-plugin-', '')}/${rule}\` | ${reason.replaceAll('|', '\\|')} |`;
});

const doc = `# Rules that do not run on oxlint

<!-- Generated by scripts/generate-oxlint-runtimes-report.mts. Do not edit by hand. -->

Every rule declares \`meta.interop.runtimes\`. A rule lists \`oxlint\` only when its
own test suite passes on oxlint's \`RuleTester\` as well as ESLint's
(\`vitest.dual-rule-tester.ts\`), and it is not type-aware. Measured on oxlint
\`${evidence.survey.oxlint}\`: **${total - eslintOnly.length} of ${total}** rules run on
both engines. The ${eslintOnly.length} below run on ESLint only. In oxlint or Vite+ they still load,
but nothing guarantees they report the same findings, so do not rely on them there.

Re-measure with \`npm run oxlint:runtimes:survey\`, then \`npm run oxlint:runtimes\`.

| Rule | Why it is ESLint-only |
| :--- | :--- |
${rows.join('\n')}
`;

const formatted = await prettier.format(doc, {
  ...(await prettier.resolveConfig(OUT)),
  filepath: OUT,
});
const current = fs.existsSync(OUT) ? fs.readFileSync(OUT, 'utf8') : null;
if (current === formatted) {
  console.log('✅ docs/oxlint-runtimes.md in sync.');
} else if (process.argv.includes('--check')) {
  console.log(
    '❌ docs/oxlint-runtimes.md is stale. Run `npm run oxlint:runtimes`.',
  );
  process.exit(1);
} else {
  fs.writeFileSync(OUT, formatted);
  console.log(
    `📝 wrote docs/oxlint-runtimes.md (${eslintOnly.length} ESLint-only of ${total}).`,
  );
}
