#!/usr/bin/env -S npx tsx

/**
 * generate-oxlint-aliases.mts — one `oxlint-plugin-<name>` package per
 * `eslint-plugin-<name>`, so oxlint and Vite+ users install our rules under the
 * name their ecosystem searches for.
 *
 * An alias holds no rule logic. It is a manifest that depends on the exact
 * version of its plugin, and a one-line `index.js` that re-exports the plugin's
 * `./oxlint` entry. oxlint takes the rule prefix from the plugin's `meta.name`
 * (`eslint-plugin-pg` → `pg`), so the alias gets the same `<name>/<rule>` IDs.
 *
 * Also writes the changesets `fixed` pairs, so a plugin and its alias always
 * release at the same version.
 *
 * Usage:
 *   tsx scripts/generate-oxlint-aliases.mts           # write
 *   tsx scripts/generate-oxlint-aliases.mts --check   # exit 1 on drift, no writes
 *
 * See docs/intents/oxlint-native-plugin-names/.
 */

import fs from 'node:fs';
import path from 'node:path';
import prettier from 'prettier';

const ROOT = path.resolve(import.meta.dirname, '..');
const PACKAGES_DIR = path.join(ROOT, 'packages');
const CHANGESET_CONFIG = path.join(ROOT, '.changeset', 'config.json');
const CHECK_ONLY = process.argv.includes('--check');

/**
 * Aliases that must not publish yet. An alias whose plugin is not on npm would
 * install-fail for everyone, so it waits for its plugin's first release.
 */
const PRIVATE = new Set(['cli-floor']);

/** Plugin keywords that describe the ESLint package, not the alias. */
const ESLINT_ONLY_KEYWORDS = new Set(['eslintplugin', 'eslint-plugin']);

interface PluginManifest {
  name: string;
  version: string;
  description?: string;
  keywords?: string[];
  homepage?: string;
  repository?: { type: string; url: string; directory?: string };
  bugs?: unknown;
  author?: unknown;
  license?: string;
  engines?: unknown;
  funding?: unknown;
  private?: boolean;
}

const plugins = fs
  .readdirSync(PACKAGES_DIR)
  .filter((dir) => dir.startsWith('eslint-plugin-'))
  .sort()
  .map((dir) => ({
    dir,
    short: dir.slice('eslint-plugin-'.length),
    manifest: JSON.parse(
      fs.readFileSync(path.join(PACKAGES_DIR, dir, 'package.json'), 'utf8'),
    ) as PluginManifest,
  }))
  .filter(({ manifest }) => !manifest.private);

function renderManifest(short: string, plugin: PluginManifest): string {
  const alias = `oxlint-plugin-${short}`;
  // The docs URL carries the package name as its UTM campaign; keep that
  // convention so npm referrals are attributed to the alias, not the plugin.
  const homepage = plugin.homepage?.replace(
    `utm_campaign=${plugin.name}`,
    `utm_campaign=${alias}`,
  );
  const keywords = [
    'oxlint',
    'oxlint-plugin',
    'vite-plus',
    ...(plugin.keywords ?? []).filter((k) => !ESLINT_ONLY_KEYWORDS.has(k)),
  ];
  const manifest = {
    name: alias,
    version: plugin.version,
    description: `The ${short} rules for oxlint and Vite+. Same rules and rule IDs as ${plugin.name}.`,
    ...(PRIVATE.has(short) ? { private: true } : {}),
    type: 'commonjs',
    main: './index.js',
    types: './index.d.ts',
    files: ['index.js', 'index.d.ts', 'README.md', 'LICENSE'],
    keywords: [...new Set(keywords)],
    homepage,
    repository: plugin.repository && {
      ...plugin.repository,
      directory: `packages/${alias}`,
    },
    bugs: plugin.bugs,
    author: plugin.author,
    license: plugin.license,
    engines: plugin.engines,
    funding: plugin.funding,
    publishConfig: { access: 'public' },
    dependencies: { [plugin.name]: plugin.version },
  };
  return JSON.stringify(manifest, null, 2) + '\n';
}

const HEADER = (plugin: string) =>
  `// Generated by scripts/generate-oxlint-aliases.mts. Do not edit by hand.\n` +
  `// The rules live in ${plugin}; this package only gives them an oxlint name.\n`;

const renderIndex = (plugin: string) =>
  `${HEADER(plugin)}module.exports = require('${plugin}/oxlint');\n`;

const renderTypes = (plugin: string) =>
  `${HEADER(plugin)}import plugin = require('${plugin}/oxlint');\n\nexport = plugin;\n`;

/**
 * The plugin README's OG banner block, re-attributed to the alias. Every
 * published README carries exactly one (apps/docs readme-og-banner-lock).
 */
function banner(dir: string, plugin: PluginManifest, alias: string): string {
  const readme = fs.readFileSync(
    path.join(PACKAGES_DIR, dir, 'README.md'),
    'utf8',
  );
  const block =
    /<p align="center">\s*<a [^>]*><img src="https:\/\/eslint\.interlace\.tools\/images\/og-[^"]+"[^>]*\/><\/a>\s*<\/p>/.exec(
      readme,
    );
  if (!block)
    throw new Error(`${plugin.name} README has no OG banner to reuse`);
  return block[0].replaceAll(
    `utm_campaign=${plugin.name}`,
    `utm_campaign=${alias}`,
  );
}

function renderReadme(
  dir: string,
  short: string,
  plugin: PluginManifest,
): string {
  const alias = `oxlint-plugin-${short}`;
  return `# ${alias}

The \`${short}\` rules for [oxlint](https://oxc.rs/docs/guide/usage/linter) and
[Vite+](https://viteplus.dev). This package is the oxlint name for
[\`${plugin.name}\`](https://www.npmjs.com/package/${plugin.name}): the same rules, the same
rule IDs (\`${short}/<rule>\`), and the same version. It contains no rule code of its own, and it
does not install ESLint.

## Install

\`\`\`bash
npm install --save-dev ${alias}
\`\`\`

## Vite+

\`\`\`ts
// vite.config.ts
import { defineConfig } from 'vite-plus';

export default defineConfig({
  lint: {
    jsPlugins: ['${alias}'],
    rules: {
      '${short}/<rule>': 'error',
    },
  },
});
\`\`\`

## oxlint

\`\`\`json
{
  "jsPlugins": ["${alias}"],
  "rules": {
    "${short}/<rule>": "error"
  }
}
\`\`\`

## Rules

Every rule, its options and its docs are listed in the
[\`${plugin.name}\` README](https://www.npmjs.com/package/${plugin.name}#rules). Using ESLint
instead? Install \`${plugin.name}\` directly.

## License

${plugin.license ?? 'MIT'}

${banner(dir, plugin, alias)}
`;
}

// ── Plan every file, then write or compare ────────────────────────────

const planned = new Map<string, string>();
for (const { dir, short, manifest } of plugins) {
  const out = path.join(PACKAGES_DIR, `oxlint-plugin-${short}`);
  planned.set(path.join(out, 'package.json'), renderManifest(short, manifest));
  planned.set(path.join(out, 'index.js'), renderIndex(manifest.name));
  planned.set(path.join(out, 'index.d.ts'), renderTypes(manifest.name));
  planned.set(path.join(out, 'README.md'), renderReadme(dir, short, manifest));
  planned.set(
    path.join(out, 'LICENSE'),
    fs.readFileSync(path.join(PACKAGES_DIR, dir, 'LICENSE'), 'utf8'),
  );
}

const changesetConfig = JSON.parse(fs.readFileSync(CHANGESET_CONFIG, 'utf8'));
changesetConfig.fixed = plugins.map(({ short, manifest }) => [
  manifest.name,
  `oxlint-plugin-${short}`,
]);
planned.set(CHANGESET_CONFIG, JSON.stringify(changesetConfig, null, 2) + '\n');

// Through prettier, exactly as lint-staged would: otherwise the first commit
// reformats the output and `--check` reports drift on files nobody touched.
for (const [file, content] of planned) {
  const options = await prettier.resolveConfig(file);
  const info = await prettier.getFileInfo(file);
  if (info.inferredParser) {
    planned.set(
      file,
      await prettier.format(content, { ...options, filepath: file }),
    );
  }
}

const drift: string[] = [];
for (const [file, content] of planned) {
  const current = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : null;
  if (current === content) continue;
  drift.push(
    `${current === null ? 'missing' : 'differs'}  ${path.relative(ROOT, file)}`,
  );
  if (!CHECK_ONLY) {
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, content);
  }
}

// An alias directory with no plugin behind it, or a file nobody generates, is
// drift too: a deleted plugin must take its alias with it.
for (const dir of fs.readdirSync(PACKAGES_DIR)) {
  if (!dir.startsWith('oxlint-plugin-')) continue;
  for (const file of fs.readdirSync(path.join(PACKAGES_DIR, dir))) {
    const full = path.join(PACKAGES_DIR, dir, file);
    if (file === 'node_modules' || file === 'CHANGELOG.md') continue;
    if (!planned.has(full)) drift.push(`extra    ${path.relative(ROOT, full)}`);
  }
}

if (drift.length === 0) {
  console.log(`✅ ${plugins.length} oxlint-plugin-* aliases in sync.`);
} else {
  console.log(`${CHECK_ONLY ? '❌ drift' : '📝 wrote'} (${drift.length}):`);
  for (const line of drift) console.log(`   ${line}`);
  if (CHECK_ONLY) {
    console.log('\nRun `npm run oxlint:aliases` and commit the result.');
    process.exit(1);
  }
}
