{
  "cwe": "CWE-327",
  "name": "Use of a Broken or Risky Cryptographic Algorithm",
  "owasp": "A02:2021",
  "severity": "CRITICAL",
  "expectedPlugins": [
    "eslint-plugin-jwt",
    "eslint-plugin-node-security"
  ],
  "fixtures": {
    "vulnerable": [
      {
        "file": "sign-alg-none.js",
        "description": "jwt.sign with algorithm: 'none'"
      },
      {
        "file": "verify-allows-none.js",
        "description": "jwt.verify with algorithms array including 'none'"
      },
      {
        "file": "gcm-decipher-no-final.js",
        "description": "AEAD misuse — aes-256-gcm decryption never calls .final(), auth tag unverified"
      },
      {
        "file": "gcm-decrypt-no-authtag.js",
        "description": "AEAD misuse — aes-256-gcm decryption without setAuthTag, integrity never checked"
      },
      {
        "file": "create-cipher-deprecated.js",
        "description": "crypto.createCipher — no IV, key derived by MD5",
        "rule": "node-security/no-deprecated-cipher-method"
      },
      {
        "file": "rsa-pkcs1-padding.js",
        "description": "RSA decryption with PKCS#1 v1.5 padding (Bleichenbacher)",
        "rule": "node-security/no-insecure-rsa-padding"
      },
      {
        "file": "crypto-hash-sha1.js",
        "description": "sha1() imported from the crypto-hash package",
        "rule": "node-security/no-sha1-hash"
      }
    ],
    "safe": [
      {
        "file": "sign-rs256.js",
        "description": "jwt.sign with explicit RS256 algorithm"
      },
      {
        "file": "verify-allowlist.js",
        "description": "jwt.verify with explicit allowlist excluding none"
      },
      {
        "file": "gcm-decrypt-verified.js",
        "description": "aes-256-gcm decryption with setAuthTag + final() enforcing integrity"
      },
      {
        "file": "gcm-encrypt-authtag.js",
        "description": "aes-256-gcm encryption capturing the auth tag via getAuthTag()"
      },
      {
        "file": "create-cipheriv-explicit.js",
        "description": "crypto.createCipheriv with an explicit key and IV",
        "rule": "node-security/no-deprecated-cipher-method"
      },
      {
        "file": "rsa-oaep-padding.js",
        "description": "RSA decryption with OAEP padding",
        "rule": "node-security/no-insecure-rsa-padding"
      },
      {
        "file": "crypto-hash-sha256.js",
        "description": "sha256() from the same package",
        "rule": "node-security/no-sha1-hash"
      }
    ]
  }
}
