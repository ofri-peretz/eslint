{
  "note": "Rules that decide from an identifier name with no option to REPLACE the vocabulary. Shrink-only.",
  "rules": [
    "express-security/no-permissive-trust-proxy",
    "express-security/require-route-authentication",
    "import-next/no-mutable-exports",
    "lambda-security/no-unbounded-batch-processing",
    "lambda-security/no-unvalidated-event-body",
    "nestjs-security/no-permissive-cors",
    "node-security/no-env-injection",
    "node-security/no-ssrf",
    "node-security/no-unsafe-buffer-alloc",
    "secure-coding/detect-weak-password-validation",
    "secure-coding/no-unsafe-regex-construction",
    "secure-coding/no-xpath-injection"
  ]
}
