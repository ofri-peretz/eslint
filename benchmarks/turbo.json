{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // This package has no src/, so the root task's inputs would hash nothing
      // that matters and the lock would cache-hit forever. The methodology
      // receipt lock reads suite sources directly — they are inputs.
      "inputs": [
        "__tests__/**",
        "lib/**",
        "suites/**/*.ts",
        "suites/**/*.mjs",
        "score.ts",
        "vitest.config.mts",
        "package.json",
        // Locks here also read the plugins' test files and sources (the
        // sealed-vs-open lock regenerates RULE_CASES.json from every
        // packages/*/src test). Without these the task cache-hit on a PR that
        // added an untagged FN case, and main went red with a green gate.
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/scripts/rule-case-ledger.ts",
        "$TURBO_ROOT$/eslint.real-source.config.mjs"
      ],
      "outputs": []
    }
  }
}
