# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data
# Generated by scripts/build-corpus-index.ts, byte-deterministic by contract so
# re-runs produce no diff. Prettier collapses short arrays onto one line, which
# the emitter does not; formatting it would make the script and the formatter
# fight over the same file on every run.
/benchmarks/corpus-index.json
# Same fight: the docs write-lock test pins this to exact JSON.stringify output
# (no trailing newline), and weekly-benchmark.yml prettier-formats staged files.
/apps/docs/src/data/headline-bench.json
# Generated by scripts/oxlint-builtin-overlap.ts; `oxlint:overlap:check` compares it
# byte-for-byte, so formatting it would make the script and prettier fight.
/docs/oxlint-builtin-overlap.md
# Vendored by scripts/vendor-estree-types.ts from the pinned @typescript-eslint
# packages; `--check` compares it byte-for-byte, so prettier must not touch it.
/packages/eslint-devkit/src/types/estree
# Generated by apps/docs/scripts/sync-rules-docs.ts from each rule's .md;
# rule-docs-sync-drift.test.ts compares them byte-for-byte with a fresh
# generation, and the generator's output is not prettier's (double quotes, one
# long import, no trailing newline). Formatting one fails that test; leaving it
# fails check:format-drift for any PR that edits a rule doc.
/apps/docs/content/docs/**/rules/*.mdx
