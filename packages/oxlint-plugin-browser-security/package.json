{
  "name": "oxlint-plugin-browser-security",
  "version": "3.0.1",
  "description": "The browser-security rules for oxlint and Vite+. Same rules and rule IDs as eslint-plugin-browser-security.",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "vite-plus",
    "eslint",
    "static-analysis",
    "linting",
    "code-quality",
    "security",
    "sast",
    "appsec",
    "vulnerability",
    "owasp",
    "cwe",
    "interlace-security",
    "browser",
    "browser-security",
    "frontend-security",
    "web-security",
    "xss",
    "dom-xss",
    "cwe-79",
    "clickjacking",
    "mixed-content",
    "postmessage",
    "localstorage",
    "indexeddb",
    "cookies",
    "websocket",
    "service-worker",
    "csp",
    "content-security-policy",
    "llm-optimized",
    "ai-assistant",
    "typescript"
  ],
  "homepage": "https://eslint.interlace.tools/docs/security/plugin-browser-security?utm_source=npm&utm_medium=referral&utm_campaign=oxlint-plugin-browser-security",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/oxlint-plugin-browser-security"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-plugin-browser-security": "3.0.1"
  }
}
