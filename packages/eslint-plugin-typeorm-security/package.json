{
  "name": "eslint-plugin-typeorm-security",
  "version": "0.3.7",
  "description": "ESLint plugin for typeorm \u2014 detects SQL injection in raw queries built with string concatenation or template literals, connection configuration that disables TLS or certificate validation, and hardcoded database credentials.",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./oxlint": {
      "types": "./dist/src/oxlint.d.ts",
      "default": "./dist/src/oxlint.js"
    }
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://eslint.interlace.tools/docs/security/plugin-typeorm-security?utm_source=npm&utm_medium=referral&utm_campaign=eslint-plugin-typeorm-security",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/eslint-plugin-typeorm-security"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "static-analysis",
    "linting",
    "code-quality",
    "security",
    "sast",
    "appsec",
    "vulnerability",
    "owasp",
    "cwe",
    "interlace-security",
    "typeorm",
    "typeorm",
    "sql",
    "sql-injection",
    "cwe-89",
    "raw-query",
    "database",
    "database-security",
    "mysql",
    "sqlite",
    "postgres",
    "llm-optimized",
    "ai-assistant",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0",
    "typeorm": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    }
  },
  "dependencies": {
    "@interlace/eslint-devkit": "^1.19.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.68.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo -p tsconfig.lib.json --noEmit"
  },
  "funding": {
    "type": "github",
    "url": "git+https://github.com/ofri-peretz/eslint.git"
  },
  "interlace": {
    "surface": {
      "kind": "npm",
      "modules": [
        "typeorm"
      ]
    }
  }
}
