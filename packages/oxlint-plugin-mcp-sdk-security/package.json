{
  "name": "oxlint-plugin-mcp-sdk-security",
  "version": "2.0.2",
  "description": "Oxlint MCP security rules for the Model Context Protocol SDK — follows tool arguments into shells, file paths, URLs, SQL and eval; catches credential leaks, untrusted text in model-facing descriptions and prompts, unhardened HTTP transports, shared stateless servers, predictable session ids, untrusted stdio commands and schema/handler drift. Same rules and rule IDs as eslint-plugin-mcp-sdk-security, for oxlint and Vite+.",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "vite-plus",
    "eslint",
    "static-analysis",
    "linting",
    "code-quality",
    "security",
    "sast",
    "appsec",
    "vulnerability",
    "owasp",
    "cwe",
    "interlace-security",
    "mcp",
    "mcp-security",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "tool-calling",
    "tool-poisoning",
    "ai-security",
    "llm",
    "llm-security",
    "agentic",
    "typescript"
  ],
  "homepage": "https://eslint.interlace.tools/docs/security/plugin-mcp-sdk-security?utm_source=npm&utm_medium=referral&utm_campaign=oxlint-plugin-mcp-sdk-security",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/oxlint-plugin-mcp-sdk-security"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-plugin-mcp-sdk-security": "2.0.2"
  }
}
