{
  "name": "eslint-plugin-import-next",
  "version": "2.6.0",
  "description": "ESLint plugin for imports and module boundaries — drop-in replacement for eslint-plugin-import, 3.1x faster end-to-end, zero-config migration.",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./src/types/index.d.ts",
      "default": "./src/types/index.js"
    },
    "./oxlint": {
      "types": "./dist/src/oxlint.d.ts",
      "default": "./dist/src/oxlint.js"
    }
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://eslint.interlace.tools/docs/quality/plugin-import-next?utm_source=npm&utm_medium=referral&utm_campaign=eslint-plugin-import-next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/eslint-plugin-import-next"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "static-analysis",
    "linting",
    "code-quality",
    "interlace-quality",
    "eslint-plugin-import",
    "eslint-plugin-import-alternative",
    "import",
    "imports",
    "no-cycle",
    "circular-dependencies",
    "dependency-graph",
    "import-order",
    "barrel-file",
    "tree-shaking",
    "monorepo",
    "modules",
    "module-resolution",
    "commonjs",
    "esm",
    "llm-optimized",
    "ai-assistant",
    "typescript",
    "auto-fix",
    "mcp",
    "agentic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0",
    "typescript": "^4.8.4 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@interlace/eslint-devkit": "^1.17.3",
    "oxc-resolver": "^11.24.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.68.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo -p tsconfig.lib.json --noEmit"
  },
  "funding": {
    "type": "github",
    "url": "git+https://github.com/ofri-peretz/eslint.git"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
