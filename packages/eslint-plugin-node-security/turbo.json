{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // `build`, not the root's `^build`. This package has a test that reads its OWN
      // dist/src, and `^build` orders upstream builds only — so this package's build can
      // run concurrently with its test, and scripts/build-package.ts rmSync's dist before
      // rebuilding. The test then fails with `ENOENT: scandir .../dist/src`,
      // intermittently and only under the parallel fan-out. Same reasoning as
      // packages/eslint-devkit/turbo.json.
      //
      // Package Configurations REPLACE the task rather than deep-merging it, so
      // inputs/outputs are restated from the root config and must stay in sync with it.
      // `$TURBO_DEFAULT$` is load-bearing: #343 set it to stop turbo replaying stale
      // PASSes for test tasks, and an explicit input list here would silently reintroduce
      // that bug for this package.
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**", "test-report.junit.xml", "test-results/**"]
    }
  }
}
