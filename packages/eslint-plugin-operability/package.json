{
  "name": "eslint-plugin-operability",
  "version": "4.1.0",
  "description": "ESLint plugin for production operability — bans debug code and console logging in production, verbose error messages, and process.exit calls.",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./oxlint": {
      "types": "./dist/src/oxlint.d.ts",
      "default": "./dist/src/oxlint.js"
    }
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "static-analysis",
    "linting",
    "code-quality",
    "interlace-quality",
    "operability",
    "observability",
    "production-ready",
    "logging",
    "log-quality",
    "debug-code",
    "sre",
    "data-minimization",
    "llm-optimized",
    "ai-assistant",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@interlace/eslint-devkit": "^1.19.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.68.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/eslint-plugin-operability"
  },
  "homepage": "https://eslint.interlace.tools/docs/quality/plugin-operability?utm_source=npm&utm_medium=referral&utm_campaign=eslint-plugin-operability",
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0"
  },
  "funding": {
    "type": "github",
    "url": "git+https://github.com/ofri-peretz/eslint.git"
  }
}
