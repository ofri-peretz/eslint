{
  "name": "oxlint-plugin-import-next",
  "version": "4.1.8",
  "description": "Oxlint import rules — eslint-plugin-import replacement for ESLint 10 (and 8, 9): same import/* rule names and settings (node, typescript and custom-alias resolvers), passes 95% of its own test cases. Flat config. Same rules and rule IDs as eslint-plugin-import-next, for oxlint and Vite+.",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "vite-plus",
    "eslint",
    "static-analysis",
    "linting",
    "code-quality",
    "interlace-quality",
    "eslint-plugin-import",
    "eslint-plugin-import-alternative",
    "eslint-plugin-import-replacement",
    "eslint-10",
    "eslint10",
    "flat-config",
    "peer-dependency",
    "import",
    "imports",
    "no-cycle",
    "circular-dependencies",
    "dependency-graph",
    "import-order",
    "barrel-file",
    "tree-shaking",
    "monorepo",
    "modules",
    "module-resolution",
    "commonjs",
    "esm",
    "llm-optimized",
    "ai-assistant",
    "typescript",
    "auto-fix",
    "mcp",
    "agentic"
  ],
  "homepage": "https://eslint.interlace.tools/docs/quality/plugin-import-next?utm_source=npm&utm_medium=referral&utm_campaign=oxlint-plugin-import-next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/oxlint-plugin-import-next"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "eslint-plugin-import-next": "4.1.8"
  }
}
