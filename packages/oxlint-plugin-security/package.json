{
  "name": "oxlint-plugin-security",
  "version": "0.1.0",
  "description": "Drop-in replacement for eslint-plugin-security on oxlint and Vite+: the same security/<rule> IDs, backed by Interlace's security rules.",
  "private": true,
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "mapping.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "vite-plus",
    "eslint-plugin-security",
    "security",
    "sast"
  ],
  "homepage": "https://github.com/ofri-peretz/eslint/tree/main/packages/oxlint-plugin-security#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/oxlint-plugin-security"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts"
  },
  "dependencies": {
    "eslint-plugin-node-security": "5.7.0",
    "eslint-plugin-secure-coding": "5.4.17"
  },
  "devDependencies": {
    "eslint-plugin-security": "4.2.0"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
