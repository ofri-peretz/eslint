{
  "name": "eslint-plugin-test-integrity",
  "version": "0.0.0",
  "private": true,
  "description": "ESLint plugin for test integrity \u2014 no focused tests, no unexplained skips, no fixed sleeps, no retries; plus a pre-push check for weakened assertions and unexplained snapshot updates.",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "test-integrity-diff": "./dist/src/diff/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./oxlint": {
      "types": "./dist/src/oxlint.d.ts",
      "default": "./dist/src/oxlint.js"
    },
    "./diff": {
      "types": "./dist/src/diff/checks.d.ts",
      "default": "./dist/src/diff/checks.js"
    }
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://eslint.interlace.tools/docs/quality/plugin-test-integrity?utm_source=npm&utm_medium=referral&utm_campaign=eslint-plugin-test-integrity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/eslint.git",
    "directory": "packages/eslint-plugin-test-integrity"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "static-analysis",
    "linting",
    "code-quality",
    "interlace-quality",
    "testing",
    "vitest",
    "jest",
    "playwright",
    "mocha",
    "flaky-tests",
    "test-only",
    "test-skip",
    "agent-ready",
    "ai-agents",
    "llm-optimized",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "eslint": "^8.40.0 || ^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@interlace/eslint-devkit": "^2.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/rule-tester": "^8.68.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo -p tsconfig.lib.json --noEmit"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/ofri-peretz/eslint"
  },
  "interlace": {
    "surface": {
      "kind": "language",
      "note": "Test-runner call shapes (vitest, jest, mocha, Playwright, node:test, bun:test) over plain JS/TS. No runtime SDK dependency."
    }
  }
}
