{
  "name": "@interlace/eslint-devkit",
  "version": "1.4.4",
  "description": "Toolkit for building ESLint plugins in TypeScript — AST helpers, type utilities, rule-creation scaffolding, security benchmarks, and SARIF output.",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "import": "./dist/src/index.js"
    },
    "./resolver": {
      "types": "./dist/src/resolver.d.ts",
      "require": "./dist/src/resolver.js",
      "import": "./dist/src/resolver.js"
    },
    "./package.json": "./package.json"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ofri-peretz/eslint/tree/main/packages/eslint-devkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofri-peretz/eslint",
    "directory": "packages/eslint-devkit"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/eslint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslint-devkit",
    "eslint-toolkit",
    "eslint-plugin-development",
    "custom-rules",
    "rule-authoring",
    "typescript",
    "typescript-eslint",
    "utilities",
    "ast",
    "ast-utils",
    "type-checking",
    "plugin-development",
    "static-analysis",
    "linting",
    "sarif",
    "owasp",
    "cwe",
    "security",
    "llm-optimized",
    "ai-assistant",
    "auto-fix"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-package.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "peerDependencies": {
    "@typescript-eslint/utils": "^7.0.0 || ^8.0.0",
    "eslint": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "oxc-resolver": "^11.24.2",
    "tslib": "^2.3.0",
    "typescript": ">=4.8.4"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/utils": {
      "optional": true
    },
    "oxc-resolver": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.2",
    "gpt-tokenizer": "^3.4.0",
    "@typescript-eslint/types": "^8.46.2",
    "@typescript-eslint/utils": "^8.46.2",
    "oxc-resolver": "^11.24.2",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/ofri-peretz/eslint"
  }
}
